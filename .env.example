# PhotoGallery server environment variables
# Скопируйте в .env и укажите свои значения:
#   cp .env.example .env && chmod 600 .env

# Обязательно: пароль для админ-панели (без него генерируется временный)
PHOTOGALLERY_ADMIN_PASSWORD=your_secure_password

# Режим отладки Werkzeug: только для разработки
# PHOTOGALLERY_DEBUG=1

# Разрешённые CORS origin через запятую (по умолчанию CORS отключён)
# PHOTOGALLERY_ALLOWED_ORIGINS=https://example.com,https://admin.example.com